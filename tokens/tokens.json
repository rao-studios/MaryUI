{
  "$description": "Liquid Platinum design tokens (W3C Design Tokens format). This file is the source of truth: `npm run tokens` emits src/styles/tokens.css, src/tokens/tokens.ts, and tokens/export/liquid-platinum.sketchpalette. Values may alias other tokens with {path.to.token}.",

  "platinum": {
    "$type": "color",
    "$description": "The raw metal ramp: near-white to deep steel, with a cool blue-violet cast.",
    "0": { "$value": "#f7f7f9" },
    "1": { "$value": "#eeeff2" },
    "2": { "$value": "#e3e5e9" },
    "3": { "$value": "#d4d7dd" },
    "4": { "$value": "#c1c5cd" },
    "5": { "$value": "#a9aeb8" },
    "6": { "$value": "#8b909b" },
    "7": { "$value": "#6b707b" },
    "8": { "$value": "#4a4e57" },
    "9": { "$value": "#2a2d33" }
  },

  "surface": {
    "$type": "color",
    "$description": "Semantic surface colors. Every brushed surface is a vertical gradient from -top to -bottom.",
    "window-top": { "$value": "{platinum.1}" },
    "window-bottom": { "$value": "{platinum.3}" },
    "titlebar-top": { "$value": "{platinum.0}" },
    "titlebar-bottom": { "$value": "{platinum.4}" },
    "titlebar-inactive-top": { "$value": "{platinum.1}" },
    "titlebar-inactive-bottom": { "$value": "{platinum.2}" },
    "menubar-top": { "$value": "{platinum.0}" },
    "menubar-bottom": { "$value": "{platinum.3}" },
    "raised-top": { "$value": "{platinum.0}" },
    "raised-bottom": { "$value": "{platinum.3}" },
    "pressed-top": { "$value": "{platinum.4}" },
    "pressed-bottom": { "$value": "{platinum.3}" },
    "well": { "$value": "{platinum.0}" },
    "body": { "$value": "{platinum.0}" },
    "sidebar": { "$value": "{platinum.2}" },
    "menu": { "$value": "rgba(238, 239, 242, 0.94)" },
    "selected": { "$value": "rgba(59, 125, 216, 0.16)" }
  },

  "ink": {
    "$type": "color",
    "primary": { "$value": "#1f2228" },
    "secondary": { "$value": "#4a4e57" },
    "tertiary": { "$value": "#7a7f8a" },
    "disabled": { "$value": "#a9aeb8" },
    "inverse": { "$value": "#f7f7f9" },
    "on-accent": { "$value": "#ffffff" },
    "emboss": { "$value": "rgba(255, 255, 255, 0.8)", "$description": "Text highlight below embossed labels." }
  },

  "accent": {
    "$type": "color",
    "$description": "Two appearances, as in Aqua's Blue / Graphite preference. base.css maps the chosen one onto --lp-accent-*.",
    "blue": {
      "base": { "$value": "#3b7dd8" },
      "deep": { "$value": "#2a5fae" },
      "light": { "$value": "#8fb8ee" },
      "soft": { "$value": "rgba(59, 125, 216, 0.18)" },
      "focus-ring": { "$value": "rgba(59, 125, 216, 0.5)" }
    },
    "graphite": {
      "base": { "$value": "#6f7683" },
      "deep": { "$value": "#4f5561" },
      "light": { "$value": "#aab0bb" },
      "soft": { "$value": "rgba(111, 118, 131, 0.2)" },
      "focus-ring": { "$value": "rgba(111, 118, 131, 0.5)" }
    }
  },

  "traffic": {
    "$type": "color",
    "$description": "Window indicator liquids. base = liquid body, deep = the well behind it, light = the surface tint.",
    "close": {
      "base": { "$value": "#ee6b5f" },
      "deep": { "$value": "#a83a30" },
      "light": { "$value": "#ffb7ae" }
    },
    "minimize": {
      "base": { "$value": "#f2bd4f" },
      "deep": { "$value": "#a6781a" },
      "light": { "$value": "#ffe6aa" }
    },
    "zoom": {
      "base": { "$value": "#63c657" },
      "deep": { "$value": "#2c7f28" },
      "light": { "$value": "#bdf2b3" }
    },
    "inactive": { "$value": "#c1c5cd" },
    "inactive-deep": { "$value": "#8b909b" },
    "rim": { "$value": "rgba(0, 0, 0, 0.32)" },
    "gloss": { "$value": "rgba(255, 255, 255, 0.85)" }
  },

  "liquid": {
    "$type": "number",
    "$description": "Bubble liquid: fill level as a fraction of the well, and the two wave layers' opacities.",
    "fill": { "$value": 0.6 },
    "opacity-front": { "$value": 0.95 },
    "opacity-back": { "$value": 0.55 }
  },

  "sheen": {
    "$description": "The specular highlight that slides across brushed surfaces. light-x is where the room light sits, as a fraction of viewport width.",
    "color": { "$type": "color", "$value": "#ffffff" },
    "alpha": { "$type": "number", "$value": 0.5 },
    "alpha-inactive": { "$type": "number", "$value": 0.18 },
    "angle": { "$type": "dimension", "$value": "105deg" },
    "light-x": { "$type": "number", "$value": 0.35 }
  },

  "brush": {
    "$description": "Parameters of the baked brushed-metal tile (see src/lib/textures.ts).",
    "opacity": { "$type": "number", "$value": 0.26 },
    "freq-x": { "$type": "number", "$value": 0.02 },
    "freq-y": { "$type": "number", "$value": 0.6 },
    "octaves": { "$type": "number", "$value": 2 },
    "seed": { "$type": "number", "$value": 7 },
    "tile": { "$type": "dimension", "$value": "256px" }
  },

  "edge": {
    "$type": "color",
    "light": { "$value": "rgba(255, 255, 255, 0.78)" },
    "dark": { "$value": "rgba(0, 0, 0, 0.2)" },
    "hairline": { "$value": "rgba(0, 0, 0, 0.32)" },
    "divider": { "$value": "rgba(0, 0, 0, 0.1)" }
  },

  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "14px" },
    "window": { "$value": "12px" },
    "pill": { "$value": "999px" }
  },

  "shadow": {
    "$type": "shadow",
    "window": {
      "$value": [
        { "offsetX": "0", "offsetY": "14px", "blur": "36px", "spread": "0", "color": "rgba(20, 22, 28, 0.26)" },
        { "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px", "color": "rgba(0, 0, 0, 0.28)" }
      ]
    },
    "window-focused": {
      "$value": [
        { "offsetX": "0", "offsetY": "24px", "blur": "56px", "spread": "0", "color": "rgba(20, 22, 28, 0.4)" },
        { "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px", "color": "rgba(0, 0, 0, 0.34)" }
      ]
    },
    "menu": {
      "$value": [
        { "offsetX": "0", "offsetY": "10px", "blur": "30px", "spread": "0", "color": "rgba(20, 22, 28, 0.3)" },
        { "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px", "color": "rgba(0, 0, 0, 0.22)" }
      ]
    },
    "emboss-raised": {
      "$value": [
        { "inset": true, "offsetX": "0", "offsetY": "1px", "blur": "0", "spread": "0", "color": "{edge.light}" },
        { "inset": true, "offsetX": "0", "offsetY": "-1px", "blur": "0", "spread": "0", "color": "{edge.dark}" }
      ]
    },
    "emboss-well": {
      "$value": [
        { "inset": true, "offsetX": "0", "offsetY": "1px", "blur": "3px", "spread": "0", "color": "rgba(0, 0, 0, 0.28)" },
        { "inset": true, "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px", "color": "rgba(0, 0, 0, 0.12)" }
      ]
    },
    "emboss-pressed": {
      "$value": [
        { "inset": true, "offsetX": "0", "offsetY": "2px", "blur": "4px", "spread": "0", "color": "rgba(0, 0, 0, 0.3)" }
      ]
    }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "7": { "$value": "32px" },
    "8": { "$value": "40px" }
  },

  "size": {
    "$type": "dimension",
    "menubar-height": { "$value": "24px" },
    "titlebar-height": { "$value": "28px" },
    "traffic": { "$value": "12px" },
    "traffic-gap": { "$value": "8px" },
    "control-height": { "$value": "22px" },
    "control-height-sm": { "$value": "18px" },
    "resize-grip": { "$value": "6px" },
    "resize-corner": { "$value": "14px" },
    "window-min-w": { "$value": "240px" },
    "window-min-h": { "$value": "160px" }
  },

  "font": {
    "$type": "fontFamily",
    "ui": { "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "Helvetica Neue", "Helvetica", "Arial", "sans-serif"] },
    "display": { "$value": ["Iowan Old Style", "Palatino Linotype", "Palatino", "Georgia", "serif"] },
    "mono": { "$value": ["SFMono-Regular", "ui-monospace", "Menlo", "Consolas", "monospace"] }
  },

  "text": {
    "xs": { "$type": "dimension", "$value": "11px" },
    "sm": { "$type": "dimension", "$value": "12px" },
    "md": { "$type": "dimension", "$value": "13px" },
    "lg": { "$type": "dimension", "$value": "15px" },
    "xl": { "$type": "dimension", "$value": "20px" },
    "xxl": { "$type": "dimension", "$value": "28px" },
    "weight-regular": { "$type": "fontWeight", "$value": 400 },
    "weight-medium": { "$type": "fontWeight", "$value": 500 },
    "weight-semibold": { "$type": "fontWeight", "$value": 600 },
    "weight-bold": { "$type": "fontWeight", "$value": 700 },
    "leading-tight": { "$type": "number", "$value": 1.2 },
    "leading-normal": { "$type": "number", "$value": 1.45 }
  },

  "motion": {
    "$description": "Durations for discrete transitions; springs as {frequency Hz, damping ratio}; slosh is the bubble pendulum.",
    "fast": { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "200ms" },
    "slow": { "$type": "duration", "$value": "360ms" },
    "ease-out": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "ease-spring": { "$type": "cubicBezier", "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)" },
    "spring-sheen": { "$type": "number", "frequency": { "$value": 1.2 }, "damping": { "$value": 0.45 } },
    "spring-tilt": { "$type": "number", "frequency": { "$value": 1.6 }, "damping": { "$value": 0.6 } },
    "spring-jelly": { "$type": "number", "frequency": { "$value": 2.2 }, "damping": { "$value": 0.55 } },
    "spring-fly": { "$type": "number", "frequency": { "$value": 2.3 }, "damping": { "$value": 0.8 } },
    "slosh-frequency": { "$type": "number", "$value": 1.7 },
    "slosh-damping": { "$type": "number", "$value": 0.14 },
    "slosh-gain": { "$type": "number", "$value": 0.00005 },
    "slosh-max": { "$type": "number", "$value": 0.5 },
    "slosh-max-accel": { "$type": "number", "$value": 12000 },
    "jelly-max-scale": { "$type": "number", "$value": 0.035 },
    "jelly-max-skew": { "$type": "number", "$value": 2.5 },
    "tilt-max": { "$type": "number", "$value": 3 },
    "velocity-ref": { "$type": "number", "$value": 2500 },
    "swirl-period": { "$type": "duration", "$value": "7s" },
    "drift-period": { "$type": "duration", "$value": "45s" }
  },

  "z": {
    "$type": "number",
    "wallpaper": { "$value": 0 },
    "windows": { "$value": 100 },
    "menubar": { "$value": 600 },
    "menus": { "$value": 700 }
  }
}
